{
  "expo": {
    "name": "안녕아가",
    "slug": "carelog",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/annyeongaga-icon.png",
    "scheme": "annyeongaga",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/annyeongaga-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FEF5DF",
        "foregroundImage": "./assets/images/annyeongaga-adaptive-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.woojulab.annyeongaga",
      "allowBackup": true,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FEF5DF",
          "image": "./assets/images/annyeongaga-adaptive-foreground.png",
          "imageWidth": 220
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "95c25fb9-30ce-4f83-ac12-10f07e0a3658"
      }
    },
    "owner": "martin.kim"
  }
}
